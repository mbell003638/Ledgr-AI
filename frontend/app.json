{
  "expo": {
    "name": "Ledgr",
    "slug": "ledgr-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ledgr",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ahem.ledgrai",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan receipts to auto-fill vendor bills",
        "NSMicrophoneUsageDescription": "Dictate transactions hands-free",
        "NSPhotoLibraryUsageDescription": "Attach receipt photos to bills"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1C4030"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.ahem.ledgrai",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Dictate transactions hands-free"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan receipts to auto-fill vendor bills"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Scan receipts to auto-fill vendor bills",
          "photosPermission": "Attach receipt photos to bills"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1C4030"
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
